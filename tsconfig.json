{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "packages",
    "outDir": "dist",
    "strict": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "sourceMap": true
  },
  "include": [
    "packages/**/*.ts",
    "packages/**/*.cts"
  ],
  "exclude": [
    "packages/renderer",
    "packages/callsign-core/target"
  ]
}
