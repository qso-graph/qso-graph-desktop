{
  "name": "qg-desktop",
  "productName": "QSO Graph Desktop",
  "version": "0.0.0-preview.1",
  "private": true,
  "description": "QSO Graph Desktop — local P0 preview",
  "license": "GPL-3.0-only",
  "author": "QSO Graph contributors",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "node scripts/clean-dist.mjs && node scripts/build-native.mjs && tsc && tsc -p tsconfig.renderer.json && node scripts/svelte-check.mjs && vite build",
    "start": "npm run build && electron .",
    "package": "npm run build && electron-builder --dir --publish never",
    "installer": "npm run build && electron-builder --publish never",
    "verify": "node scripts/verify.mjs",
    "check": "node scripts/verify.mjs --fast"
  },
  "devDependencies": {
    "@doyensec/electronegativity": "1.10.3",
    "@electron/asar": "3.4.1",
    "@eslint/js": "10.0.1",
    "@fortawesome/fontawesome-free": "7.3.1",
    "@playwright/test": "1.63.0",
    "@storybook/addon-svelte-csf": "5.1.5",
    "@storybook/addon-themes": "10.6.1",
    "@storybook/svelte-vite": "10.6.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.4",
    "axe-core": "4.14.0",
    "drizzle-kit": "0.31.11",
    "electron": "44.6.0",
    "electron-builder": "26.15.3",
    "eslint": "10.12.0",
    "eslint-plugin-security": "4.2.0",
    "eslint-plugin-svelte": "3.23.0",
    "storybook": "10.6.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "build": {
    "appId": "org.qso-graph.desktop",
    "productName": "QSO Graph Desktop",
    "directories": {
      "output": "out"
    },
    "files": [
      "dist/**/*",
      "!dist/renderer/*.map",
      "package.json",
      "LICENSE",
      "data/reference-sources.json",
      "data/service-profiles.json",
      "data/app-grants.json",
      "data/app-sources.json",
      "drizzle/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "dist/native/*.node",
      "dist/native/*.dylib"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false,
      "resetAdHocDarwinSignature": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "category": "public.app-category.utilities",
      "icon": "build/icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility",
      "icon": "build/icon.png"
    }
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "pino": "10.4.0"
  }
}
