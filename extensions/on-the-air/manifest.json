{
  "manifestVersion": 1,
  "id": "on-the-air",
  "name": "On the Air",
  "tier": "official",
  "version": "1.0.0",
  "engines": { "qgd": "^1.0.0" },
  "grants": ["source:noaa-flux", "source:noaa-kp", "source:noaa-scales", "source:pota-spots", "reference:read"],
  "main": "main.js",
  "contributes": {
    "pages": [
      {
        "id": "conditions",
        "name": "Conditions",
        "description": "Solar flux, the K and A indices, NOAA's storm scales and the band outlook.",
        "refreshSeconds": 900,
        "icon": "sun",
        "network": true
      },
      {
        "id": "parks",
        "name": "Parks On the Air",
        "description": "Who is activating a POTA park now: the park, the frequency and mode, and when they were spotted.",
        "refreshSeconds": 60,
        "icon": "tree",
        "rail": true,
        "network": true
      }
    ]
  }
}
