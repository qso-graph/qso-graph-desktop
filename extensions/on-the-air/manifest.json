{
  "manifestVersion": 1,
  "id": "on-the-air",
  "name": "On the Air",
  "tier": "official",
  "version": "1.0.0",
  "engines": { "qgd": "^1.0.0" },
  "grants": ["source:noaa-flux", "source:noaa-kp", "source:noaa-scales"],
  "main": "main.js",
  "contributes": {
    "cards": [
      {
        "id": "conditions",
        "name": "Conditions",
        "description": "Solar flux, the K index, NOAA's storm scales and the band outlook.",
        "refreshSeconds": 900
      }
    ]
  }
}
