{
  "manifestVersion": 1,
  "id": "conditions",
  "name": "Conditions",
  "tier": "official",
  "version": "1.0.0",
  "engines": { "qgd": "^1.0.0" },
  "grants": ["source:noaa-flux", "source:noaa-kp", "source:noaa-scales"],
  "main": "main.js",
  "contributes": {
    "pages": [
      {
